# GitHub API authentication is required unless `gh` is already authenticated.
# Use one token variable and remove the other when copying this file to `.env`.
GITHUB_TOKEN=dummy-github-token-not-valid
GH_TOKEN=dummy-gh-token-not-valid

# Commit identity is required for automated commit and pull-request steps.
GITHUB_USER=dummy-release-user
GITHUB_EMAIL=dummy-release-user@example.invalid

# Konflux credentials are required for cluster verification and approved release steps.
KONFLUX_SERVER=https://konflux.example.invalid
KONFLUX_TOKEN=dummy-konflux-token-not-valid

# GitLab credentials are optional unless running the RPA, Pyxis, or CDN checks.
GITLAB_URL=https://gitlab.example.invalid
GITLAB_TOKEN=dummy-gitlab-token-not-valid

# Jira credentials and field IDs are optional unless running audit or Jira-gap skills.
JIRA_URL=https://jira.example.invalid
JIRA_EMAIL=dummy-jira-user@example.invalid
JIRA_TOKEN=dummy-jira-token-not-valid
JIRA_RN_TEXT_FIELD=customfield_DUMMY_RELEASE_NOTE_TEXT
JIRA_RN_TYPE_FIELD=customfield_DUMMY_RELEASE_NOTE_TYPE
JIRA_RN_STATUS_FIELD=customfield_DUMMY_RELEASE_NOTE_STATUS

# Quay credentials are required only for the image-copy stage.
QUAY_USER=dummy-quay-user
QUAY_PASSWORD=dummy-quay-password-not-valid
